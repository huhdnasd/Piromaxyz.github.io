NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=https://piroma.xyz
API_PUBLIC_URL=https://api.piroma.xyz

DISCORD_CLIENT_ID=YOUR_DISCORD_OAUTH_CLIENT_ID
DISCORD_CLIENT_SECRET=SET_IN_YOUR_HOST_SECRET_STORE
OWNER_DISCORD_ID=YOUR_DISCORD_USER_ID

# Generate each value independently with: openssl rand -base64 48
SESSION_SECRET=SET_IN_YOUR_HOST_SECRET_STORE
BOT_CONNECTION_SECRET=SET_IN_YOUR_HOST_SECRET_STORE

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SET_IN_YOUR_HOST_SECRET_STORE

# Comma-separated Discord server IDs. Only these servers' member counts are public.
APPROVED_GUILD_IDS=

# Comma-separated existing bot command names. Keep empty until the bot adapter
# explicitly implements and validates the commands.
BOT_ALLOWED_COMMANDS=

# Private records are pruned by the backend on this schedule.
BOT_LOG_RETENTION_DAYS=30
BOT_COMMAND_RETENTION_DAYS=90
